      "layers": [
        {
          "type": "image",
          "src": "bg_intro",
          "size": { "width": 100 },
          "position": { "x": 50, "y": 50, "anchor": "center" },
          "z_index": 1
        },
        {
          "type": "text",
          "content": "3 Python Tips",
          "style": "title_center",
          "position": { "x": 50, "y": 35, "anchor": "center" },
          "z_index": 3
        },
        {
          "type": "text",
          "content": "Every Beginner Must Know",
          "style": {
            "font_size": 44,
            "color": "#FFD700",
            "stroke_color": "#000000",
            "stroke_width": 3,
            "max_width_pct": 80
          },
          "position": { "x": 50, "y": 50, "anchor": "center" },
          "z_index": 3
        },
        {
          "type": "image",
          "src": "logo",
          "size": { "width": 15 },
          "position": { "x": 88, "y": 6, "anchor": "top-right" },
          "z_index": 4
        }
      ],

      "audio": {
        "voice": {
          "text": "Here are three Python tips that every beginner must know to write cleaner and faster code.",
          "voice": "en-US-GuyNeural"
        },
        "bgm": {
          "src": "bgm",
          "volume": 0.25,
          "loop": true
        }
      },

      "subtitle": {
        "enabled": true,
        "granularity": "sentence"
      }
    },

    {
      "id": "tip_1",
      "type": "main",

      "duration": { "mode": "auto" },

      "effects": [
        { "type": "fade", "duration_ms": 400 }
