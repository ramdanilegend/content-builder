      "layers": [
        {
          "type": "image",
          "src": "bg_tip1",
          "size": { "width": 100 },
          "position": { "x": 50, "y": 50, "anchor": "center" },
          "z_index": 1
        },
        {
          "type": "text",
          "content": "Tip #1",
          "style": {
            "font_size": 80,
            "color": "#FF4444",
            "stroke_color": "#FFFFFF",
            "stroke_width": 4,
            "max_width_pct": 50
          },
          "position": { "x": 50, "y": 18, "anchor": "top-center" },
          "z_index": 3
        },
        {
          "type": "text",
          "content": "List Comprehensions",
          "style": "title_center",
          "position": { "x": 50, "y": 32, "anchor": "top-center" },
          "z_index": 3
        },
        {
          "type": "text",
          "content": "[x*2 for x in range(10)]",
          "style": {
            "font_size": 38,
            "color": "#00FF88",
            "stroke_color": "#000000",
            "stroke_width": 2,
            "max_width_pct": 85
          },
          "position": { "x": 50, "y": 48, "anchor": "center" },
          "z_index": 3
        }
      ],

      "audio": {
        "voice": {
          "text": "Tip number one — use list comprehensions. Instead of writing a for loop to build a list, you can do it in a single line. It is faster and much more readable.",
          "voice": "en-US-JennyNeural"
        },
        "bgm": {
          "src": "bgm",
          "volume": 0.15,
          "loop": true
        }
      },

      "subtitle": {
        "enabled": true,
        "granularity": "word",
        "highlight": {
          "enabled": true,
          "color": "#FFD700"
        }
      }
    },

    {
      "id": "tip_2",
      "type": "main",

      "duration": { "mode": "auto" },

      "effects": [
        { "type": "fade", "duration_ms": 400 }
      ],

      "layers": [
        {
          "type": "image",
          "src": "bg_tip2",
          "size": { "width": 100 },
          "position": { "x": 50, "y": 50, "anchor": "center" },
          "z_index": 1
        },
        {
          "type": "text",
          "content": "Tip #2",
          "style": {
            "font_size": 80,
            "color": "#FF4444",
            "stroke_color": "#FFFFFF",
            "stroke_width": 4,
            "max_width_pct": 50
          },
          "position": { "x": 50, "y": 18, "anchor": "top-center" },
          "z_index": 3
        },
        {
          "type": "text",
          "content": "f-Strings",
          "style": "title_center",
          "position": { "x": 50, "y": 32, "anchor": "top-center" },
          "z_index": 3
        },
        {
          "type": "text",
          "content": "f\"Hello, {name}!\"",
          "style": {
            "font_size": 38,
            "color": "#00FF88",
            "stroke_color": "#000000",
            "stroke_width": 2,
            "max_width_pct": 85
          },
          "position": { "x": 50, "y": 48, "anchor": "center" },
          "z_index": 3
        }
      ],

      "audio": {
        "voice": {
          "text": "Tip number two — f-strings. Stop using string concatenation or the format method. With f-strings, you just put an f before the quote and embed variables directly inside curly braces.",
          "voice": "en-US-GuyNeural"
        },
        "bgm": {
          "src": "bgm",
          "volume": 0.15,
          "loop": true
        }
      },

      "subtitle": {
        "enabled": true,
        "granularity": "word",
        "highlight": {
          "enabled": true,
          "color": "#87CEEB"
        }
      }
    },

    {
      "id": "tip_3",
      "type": "main",

      "duration": { "mode": "auto" },

      "effects": [
        { "type": "fade", "duration_ms": 400 }
      ],

      "layers": [
        {
          "type": "image",
          "src": "bg_tip3",
          "size": { "width": 100 },
          "position": { "x": 50, "y": 50, "anchor": "center" },
          "z_index": 1
        },
        {
          "type": "text",
          "content": "Tip #3",
          "style": {
            "font_size": 80,
            "color": "#FF4444",
            "stroke_color": "#FFFFFF",
            "stroke_width": 4,
            "max_width_pct": 50
          },
          "position": { "x": 50, "y": 18, "anchor": "top-center" },
          "z_index": 3
        },
        {
          "type": "text",
          "content": "enumerate()",
          "style": "title_center",
          "position": { "x": 50, "y": 32, "anchor": "top-center" },
          "z_index": 3
        },
        {
          "type": "text",
          "content": "for i, v in enumerate(items)",
          "style": {
            "font_size": 36,
            "color": "#00FF88",
            "stroke_color": "#000000",
            "stroke_width": 2,
            "max_width_pct": 88
          },
          "position": { "x": 50, "y": 48, "anchor": "center" },
          "z_index": 3
        }
      ],

      "audio": {
        "voice": {
          "text": "Tip number three — use enumerate. When you need both the index and the value in a loop, never use range of len. Use enumerate instead. It is cleaner and more Pythonic.",
          "voice": "en-US-AriaNeural"
        },
        "bgm": {
          "src": "bgm",
          "volume": 0.15,
          "loop": true
        }
      },

      "subtitle": {
        "enabled": true,
        "granularity": "word",
        "highlight": {
          "enabled": true,
          "color": "#FF69B4"
        }
      }
    },

