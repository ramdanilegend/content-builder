{
  "meta": {
    "title": "Python Tips for Beginners",
    "ratio": "9:16",
    "resolution": "1080x1920",
    "fps": 30
  },

  "defaults": {
    "duration": {
      "mode": "auto",
      "fallback_ms": 3000,
      "end_delay_ms": 400
    },
    "position": {
      "unit": "percent",
      "anchor": "center"
    },
    "voice": {
      "provider": "edge_tts",
      "voice": "en-US-GuyNeural",
      "speed": 0.95,
      "pitch": 1.0
    },
    "subtitle": {
      "enabled": true,
      "mode": "burn",
      "source": "voice",
      "style": {
        "font_size": 52,
        "color": "#FFFFFF",
        "stroke_color": "#000000",
        "stroke_width": 3
      },
      "position": {
        "x": 50,
        "y": 82,
        "anchor": "bottom-center"
      }
    }
  },

  "assets": {
    "images": {
      "bg_intro":  "assets/images/bg_intro.png",
      "bg_tip1":   "assets/images/bg_tip1.png",
      "bg_tip2":   "assets/images/bg_tip2.png",
      "bg_tip3":   "assets/images/bg_tip3.png",
      "bg_outro":  "assets/images/bg_outro.png",
      "logo":      "assets/images/logo.png"
    },
