{
  "meta": {
    "title": "Pokemon Epic Battle",
    "ratio": "9:16",
    "resolution": "1080x1920",
    "fps": 30
  },

  "defaults": {
    "duration": {
      "mode": "auto",
      "fallback_ms": 3000,
      "end_delay_ms": 300
    },

    "position": {
      "unit": "percent",
      "anchor": "center"
    },

    "voice": {
      "provider": "edge_tts",
      "voice": "en-US-GuyNeural",
      "speed": 0.95,
      "pitch": 1.05
    },

    "subtitle": {
      "enabled": true,
      "mode": "burn",
      "source": "voice",

      "style": {
        "font_size": 48,
        "color": "#FFFFFF",
        "stroke_color": "#000000",
        "stroke_width": 3,
        "font_weight": "bold"
      },

      "position": {
        "x": 50,
        "y": 85,
        "anchor": "bottom-center"
      },

      "animation": {
        "type": "fade_in"
      }
    }
  },

  "assets": {
    "images": {
      "pikachu": "assets/images/pikachu.png"
    },
    "videos": {
      "pikachu_idle": "assets/videos/pikachu_idle.webm"
    },
    "audio": {
      "bgm_intro": "assets/audio/intro.mp3"
    }
  },

  "scenes": [
    {
      "id": "intro",
      "type": "intro",

      "duration": {
        "mode": "audio",
        "source": "voice"
      },

      "layers": [
        {
          "type": "text",
          "content": "In a world of powerful Pokemon...",
          "style": "title_center",

          "position": {
            "x": 50,
            "y": 20,
            "anchor": "top-center"
          },

          "z_index": 3
        }
      ],

      "audio": {
        "voice": {
          "text": "In a world of powerful Pokemon..."
        },
        "bgm": {
          "src": "bgm_intro",
          "volume": 0.4,
          "loop": true
        }
      },

      "subtitle": {
        "enabled": true,
        "mode": "burn",
        "granularity": "sentence"
      }
    },

    {
      "id": "main",
      "type": "main",

      "duration": {
        "mode": "auto"
      },

      "layers": [
        {
          "type": "video",
          "src": "pikachu_idle",
          "loop": true,

          "position": {
            "x": 50,
            "y": 65
          },

          "size": {
            "width": 45,
            "unit": "percent"
          },

          "z_index": 2
        }
      ],

      "audio": {
        "voice": {
          "text": "Pikachu uses Thunderbolt!",
          "voice": "en-US-JennyNeural"
        }
      },

      "subtitle": {
        "enabled": true,
        "mode": "burn",
        "granularity": "word",

        "highlight": {
          "enabled": true,
          "color": "#FFD700"
        }
      }
    },

    {
      "id": "outro",
      "type": "outro",

      "duration": {
        "mode": "fixed",
        "ms": 4000
      },

      "layers": [
        {
          "type": "text",
          "content": "Follow for more!",
          "style": "cta_center",
          "z_index": 3
        }
      ],

      "subtitle": {
        "enabled": false
      }
    }
  ]
}
